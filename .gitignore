db.properties
*.local.properties
application-local.properties
secrets.properties
*.env
.env

# ─── Logs & temp files ──────────────────────────────────────────────
*.log
*.tmp
*.bak
*~

# ─── OS cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Stray uploaded screenshots at repo root (design/screenshots/ is kept) ───
/Screenshot*.png

# ─── Tooling: keep project governance (.specify) but drop local settings ─
.claude/settings.local.json
