<?xml version="1.0" encoding="UTF-8"?>

<!--
  Reservations (T071, FR-24…FR-26). Book a table (no overlapping active bookings, BR-27) and move
  a booking through Seated/Completed/Cancelled/No-Show; the service releases the table hold (BR-29).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReservationController"
      styleClass="content" spacing="20">

  <HBox alignment="CENTER_LEFT">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Reservations"/>
      <Label styleClass="greeting-sub" text="Book tables and move bookings through their lifecycle."/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="refreshButton" styleClass="qa" text="Refresh"/>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <HBox spacing="20" VBox.vgrow="ALWAYS">

    <!-- Bookings + lifecycle -->
    <VBox styleClass="panel" spacing="12" HBox.hgrow="ALWAYS">
      <Label styleClass="h2" text="Bookings"/>
      <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150"/>
          <TableColumn fx:id="tableColumn" text="Table" prefWidth="80"/>
          <TableColumn fx:id="whenColumn" text="When" prefWidth="140"/>
          <TableColumn fx:id="partyColumn" text="Party" prefWidth="60"/>
          <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
      </TableView>
      <HBox spacing="8">
        <Button fx:id="seatButton" styleClass="qa" text="Seat"/>
        <Button fx:id="completeButton" styleClass="qa" text="Complete"/>
        <Button fx:id="cancelButton" styleClass="qa" text="Cancel"/>
        <Button fx:id="noShowButton" styleClass="qa" text="No-show"/>
      </HBox>
    </VBox>

    <!-- New booking -->
    <VBox styleClass="panel" spacing="14" minWidth="320" prefWidth="320">
      <Label styleClass="h2" text="New booking"/>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Table"/>
        <ComboBox fx:id="tableCombo" maxWidth="Infinity"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Customer name"/>
        <TextField fx:id="customerField"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Phone"/>
        <TextField fx:id="phoneField"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Email"/>
        <TextField fx:id="emailField"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Date &amp; time"/>
        <TextField fx:id="whenField" promptText="YYYY-MM-DD HH:MM"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Party size"/>
        <TextField fx:id="partyField"/>
      </VBox>
      <CheckBox fx:id="overrideCapacityBox" text="Allow party larger than the table"/>
      <Button fx:id="createButton" styleClass="btn-primary" text="Book table" maxWidth="Infinity"/>
    </VBox>

  </HBox>

</VBox>
