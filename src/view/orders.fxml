<?xml version="1.0" encoding="UTF-8"?>

<!--
  Point of sale (T052, FR-10…FR-17), laid out as a guided flow so a first-time cashier can read
  it left to right: START (numbered steps) → ORDER (menu + lines, with an instructive empty
  state) → BILL (totals, then discount, then the gold payment action). Every money figure shown
  is read back from the Order that OrderService/BillingService return; the controller computes
  none of them (Principle III). Finalise is one atomic service call (BR-19); on success the
  receipt PDF is written and opened (FR-16).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.OrderController"
      styleClass="content" spacing="18">

  <HBox alignment="CENTER_LEFT">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Point of Sale"/>
      <Label styleClass="greeting-sub" text="Take an order, take payment, print the bill."/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="refreshButton" styleClass="qa" text="Refresh"/>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <HBox spacing="20" VBox.vgrow="ALWAYS">

    <!-- START — numbered steps, then the resume list -->
    <VBox spacing="20" minWidth="280" prefWidth="280" maxWidth="280">
      <VBox styleClass="panel" spacing="13">
        <Label styleClass="section-label" text="START AN ORDER"/>
        <VBox styleClass="field-group" spacing="7">
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="step-num" text="1"/>
            <Label styleClass="step-title" text="Dine-in or takeaway?"/>
          </HBox>
          <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="field-group" spacing="7">
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="step-num" text="2"/>
            <Label styleClass="step-title" text="Pick a free table"/>
          </HBox>
          <ComboBox fx:id="tableCombo" maxWidth="Infinity" promptText="Choose a table…"/>
        </VBox>
        <VBox styleClass="field-group" spacing="7">
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="step-num" text="3"/>
            <Label styleClass="step-title" text="Start taking items"/>
          </HBox>
          <Button fx:id="openButton" styleClass="btn-primary" text="Open order" maxWidth="Infinity"/>
        </VBox>
      </VBox>

      <VBox styleClass="panel" spacing="12" VBox.vgrow="ALWAYS">
        <Label styleClass="section-label" text="OR PICK UP WHERE YOU LEFT OFF"/>
        <ListView fx:id="openOrdersList" VBox.vgrow="ALWAYS"/>
        <Button fx:id="resumeButton" styleClass="qa" text="Resume selected order" maxWidth="Infinity"/>
      </VBox>
    </VBox>

    <!-- ORDER — instructive empty state, or menu + lines side by side -->
    <VBox styleClass="panel" spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
      <StackPane VBox.vgrow="ALWAYS">

        <VBox fx:id="emptyState" alignment="CENTER" spacing="10">
          <Label styleClass="pos-empty-title" text="No order open yet"/>
          <Label styleClass="pos-empty-sub" wrapText="true" textAlignment="CENTER"
                 text="Start one on the left in three steps — or resume an open order from the list."/>
          <Label styleClass="pos-empty-sub" wrapText="true" textAlignment="CENTER"
                 text="Once an order is open, you add dishes here and take payment on the right."/>
        </VBox>

        <VBox fx:id="orderPane" spacing="12" visible="false" managed="false">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="orderHeader" styleClass="h2" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="hint" text="Prices update on the bill as you add items"/>
          </HBox>

          <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox spacing="8" minWidth="250" prefWidth="270">
              <Label styleClass="section-label" text="MENU — PICK A DISH"/>
              <ListView fx:id="itemsList" VBox.vgrow="ALWAYS"/>
              <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="quantityField" promptText="1" prefWidth="64"/>
                <Button fx:id="addButton" styleClass="btn-primary" text="Add to order →"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
              </HBox>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0">
              <Label styleClass="section-label" text="ON THIS ORDER"/>
              <TableView fx:id="linesTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                  <TableColumn fx:id="lineNameColumn" text="Item" prefWidth="180"/>
                  <TableColumn fx:id="lineQtyColumn" text="Qty" prefWidth="50"/>
                  <TableColumn fx:id="linePriceColumn" text="Each" prefWidth="80"/>
                  <TableColumn fx:id="lineTotalColumn" text="Total" prefWidth="90"/>
                </columns>
              </TableView>
              <HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="removeLineButton" styleClass="qa" text="Remove selected"/>
              </HBox>
            </VBox>
          </HBox>
        </VBox>

      </StackPane>
    </VBox>

    <!-- BILL — totals first, discount if needed, payment last -->
    <VBox spacing="20" minWidth="300" prefWidth="300" maxWidth="300">
      <VBox styleClass="panel" spacing="0">
        <Label styleClass="section-label" text="THE BILL"/>
        <HBox styleClass="kv-row" alignment="CENTER_LEFT">
          <Label styleClass="k" text="Subtotal"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="subtotalLabel" styleClass="v" text="0.00"/>
        </HBox>
        <HBox styleClass="kv-row" alignment="CENTER_LEFT">
          <Label styleClass="k" text="Discount"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="discountLabel" styleClass="v" text="0.00"/>
        </HBox>
        <HBox styleClass="kv-row" alignment="CENTER_LEFT">
          <Label fx:id="taxTitleLabel" styleClass="k" text="Tax"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="taxLabel" styleClass="v" text="0.00"/>
        </HBox>
        <HBox alignment="CENTER_LEFT">
          <padding><javafx.geometry.Insets top="12"/></padding>
          <Label styleClass="h2" text="Total due"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="totalLabel" styleClass="total-value" text="0.00"/>
        </HBox>
      </VBox>

      <VBox styleClass="panel" spacing="10">
        <Label styleClass="section-label" text="DISCOUNT — ONLY IF NEEDED"/>
        <HBox spacing="8">
          <ComboBox fx:id="discountTypeCombo" prefWidth="132" minWidth="132"/>
          <TextField fx:id="discountValueField" promptText="e.g. 10" prefWidth="60" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Button fx:id="applyDiscountButton" styleClass="qa" text="Apply discount" maxWidth="Infinity"/>
      </VBox>

      <VBox styleClass="panel" spacing="10">
        <Label styleClass="section-label" text="TAKE PAYMENT"/>
        <VBox styleClass="field-group" spacing="7">
          <Label text="Paying by"/>
          <ComboBox fx:id="methodCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="field-group" spacing="7">
          <Label text="Cash received (leave empty if exact)"/>
          <TextField fx:id="tenderedField" promptText="e.g. 500"/>
        </VBox>
        <Button fx:id="finaliseButton" styleClass="btn-gold" text="Take payment &amp; print bill" maxWidth="Infinity"/>
        <Button fx:id="voidButton" styleClass="danger-link" text="Void this order" maxWidth="Infinity"/>
      </VBox>
    </VBox>

  </HBox>

</VBox>
