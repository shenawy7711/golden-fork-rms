<?xml version="1.0" encoding="UTF-8"?>

<!--
  Purchasing (T064, FR-20, FR-21). Left: raise a PO (no stock change, BR-23). Right: receive a
  delivery — enter received quantities inline; the service raises on-hand atomically (BR-24).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PurchasingController"
      styleClass="content" spacing="20">

  <HBox alignment="CENTER_LEFT">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Purchasing"/>
      <Label styleClass="greeting-sub" text="Raise purchase orders and receive deliveries into stock."/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="refreshButton" styleClass="qa" text="Refresh"/>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <HBox spacing="20" VBox.vgrow="ALWAYS">

    <!-- Raise a PO -->
    <VBox styleClass="panel" spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
      <Label styleClass="h2" text="New purchase order"/>
      <HBox spacing="8">
        <VBox styleClass="field-group" spacing="7" HBox.hgrow="ALWAYS">
          <Label text="Supplier"/>
          <ComboBox fx:id="supplierCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="field-group" spacing="7">
          <Label text="Expected date"/>
          <TextField fx:id="expectedDateField" promptText="YYYY-MM-DD"/>
        </VBox>
      </HBox>

      <Label styleClass="hint" text="Add lines"/>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="lineItemCombo" prefWidth="180"/>
        <TextField fx:id="lineQtyField" promptText="Qty" prefWidth="70"/>
        <TextField fx:id="lineCostField" promptText="Unit cost" prefWidth="90"/>
        <Button fx:id="addLineButton" styleClass="qa" text="Add"/>
      </HBox>

      <TableView fx:id="draftTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
          <TableColumn fx:id="draftItemColumn" text="Item" prefWidth="180"/>
          <TableColumn fx:id="draftQtyColumn" text="Ordered" prefWidth="90"/>
          <TableColumn fx:id="draftCostColumn" text="Unit cost" prefWidth="90"/>
        </columns>
      </TableView>
      <HBox spacing="8">
        <Button fx:id="removeDraftButton" styleClass="qa" text="Remove line"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="createPoButton" styleClass="btn-primary" text="Create purchase order"/>
      </HBox>
    </VBox>

    <!-- Receive -->
    <VBox styleClass="panel" spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
      <Label styleClass="h2" text="Receive delivery"/>
      <TableView fx:id="poTable" prefHeight="160">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
          <TableColumn fx:id="poNumberColumn" text="PO" prefWidth="100"/>
          <TableColumn fx:id="poSupplierColumn" text="Supplier" prefWidth="160"/>
          <TableColumn fx:id="poStatusColumn" text="Status" prefWidth="130"/>
        </columns>
      </TableView>

      <Label styleClass="hint" text="Enter quantities received now"/>
      <TableView fx:id="receiveTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
          <TableColumn fx:id="recItemColumn" text="Item" prefWidth="160"/>
          <TableColumn fx:id="recOrderedColumn" text="Ordered" prefWidth="80"/>
          <TableColumn fx:id="recReceivedColumn" text="Received" prefWidth="80"/>
          <TableColumn fx:id="recNowColumn" text="Receive now" prefWidth="100"/>
        </columns>
      </TableView>
      <HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="receiveButton" styleClass="btn-primary" text="Record delivery"/>
      </HBox>
    </VBox>

  </HBox>

</VBox>
