<?xml version="1.0" encoding="UTF-8"?>

<!--
  Reports (T074, FR-27…FR-30). Sales / inventory / staff-activity over a date range, from finalised
  data only (BR-30). Export reproduces the displayed document exactly (FR-30). Cashiers are denied.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReportController"
      styleClass="content" spacing="20">

  <HBox alignment="CENTER_LEFT">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Reports"/>
      <Label styleClass="greeting-sub" text="Sales, inventory, and staff activity — from finalised data."/>
    </VBox>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <!-- Parameters -->
  <VBox styleClass="panel" spacing="12">
    <Label styleClass="h2" text="Parameters"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <VBox styleClass="field-group" spacing="7">
        <Label text="Report"/>
        <ComboBox fx:id="kindCombo" prefWidth="160"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Start (YYYY-MM-DD)"/>
        <TextField fx:id="startField" prefWidth="130"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="End (YYYY-MM-DD)"/>
        <TextField fx:id="endField" prefWidth="130"/>
      </VBox>
      <VBox styleClass="field-group" spacing="7">
        <Label text="Order type (sales)"/>
        <ComboBox fx:id="orderTypeCombo" prefWidth="130"/>
      </VBox>
      <CheckBox fx:id="lowOnlyBox" text="Low stock only (inventory)"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button fx:id="generateButton" styleClass="btn-primary" text="Generate"/>
      <Button fx:id="exportButton" styleClass="qa" text="Export PDF"/>
    </HBox>
  </VBox>

  <!-- Output -->
  <VBox styleClass="panel" spacing="12" VBox.vgrow="ALWAYS">
    <Label fx:id="reportTitle" styleClass="h2" text="No report generated"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
      <VBox fx:id="reportArea" spacing="10"/>
    </ScrollPane>
  </VBox>

</VBox>
