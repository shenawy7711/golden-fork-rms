<?xml version="1.0" encoding="UTF-8"?>

<!--
  Login screen (T032, FR-01). Matches design/screenshots/auth-login.png via app.css.

  Out of scope per research D-12 and Principle VI, so absent here:
    - the Login/Sign-up segmented toggle and everything behind it (accounts are
      Administrator-created via the Users screen, FR-03)
    - "Forgot password?" (no FR specifies a reset flow)
    - "Remember me" (no FR; persisting credentials cuts against BR-02)
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.AuthController"
           styleClass="auth-bg">

  <HBox styleClass="auth-card" maxWidth="980" maxHeight="560" alignment="CENTER">

    <!-- LEFT — brand panel -->
    <VBox styleClass="brand-panel" HBox.hgrow="ALWAYS" minWidth="300" prefWidth="490">

      <HBox spacing="14" alignment="CENTER_LEFT">
        <StackPane styleClass="logo-tile" minWidth="52" minHeight="52" prefWidth="52" prefHeight="52">
          <Label styleClass="logo-mark" text="GF">
            <font><javafx.scene.text.Font name="Georgia Bold" size="26"/></font>
          </Label>
        </StackPane>
        <VBox spacing="1">
          <Label styleClass="brand-eyebrow" text="RESTAURANT"/>
          <Label styleClass="brand-eyebrow" text="MANAGEMENT SYSTEM"/>
        </VBox>
      </HBox>

      <Region VBox.vgrow="ALWAYS"/>

      <VBox spacing="14">
        <Label styleClass="wordmark,heading" text="Golden Fork"/>
        <Label styleClass="lead" maxWidth="300" wrapText="true"
               text="Front of house to back of house — orders, tables, menu and stock, all in one place."/>
      </VBox>

      <Region VBox.vgrow="ALWAYS"/>

      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label styleClass="st-free" text="●"/>
        <Label styleClass="lead" text="Secure sign-in  ·  v1.0"/>
      </HBox>

    </VBox>

    <!-- RIGHT — form panel -->
    <VBox styleClass="form-panel" HBox.hgrow="ALWAYS" minWidth="320" prefWidth="490" spacing="0">

      <Region VBox.vgrow="ALWAYS"/>

      <VBox spacing="6">
        <Label styleClass="h1,heading" text="Welcome back"/>
        <Label styleClass="sub" text="Sign in to manage your restaurant."/>
      </VBox>

      <VBox spacing="18">
        <padding><Insets top="26"/></padding>

        <!-- Generic failure message (FR-01): never says which of username/password was wrong. -->
        <Label fx:id="errorLabel" styleClass="form-error" maxWidth="Infinity"
               wrapText="true" visible="false" managed="false"/>

        <VBox styleClass="field-group" spacing="7">
          <Label text="Username"/>
          <TextField fx:id="usernameField" promptText="e.g. a.ali"/>
        </VBox>

        <VBox styleClass="field-group" spacing="7">
          <Label text="Password"/>
          <StackPane>
            <!-- JavaFX 8 cannot unmask a PasswordField, so a TextField shadows it and the two
                 swap visibility; the controller keeps their text in step. -->
            <PasswordField fx:id="passwordField" promptText="••••••••"/>
            <TextField fx:id="passwordPlainField" promptText="••••••••" visible="false" managed="false"/>
            <Button fx:id="passwordToggle" styleClass="pw-toggle" text="Show"
                    StackPane.alignment="CENTER_RIGHT" focusTraversable="false"/>
          </StackPane>
        </VBox>

        <Button fx:id="loginButton" styleClass="btn-primary" text="Login"
                maxWidth="Infinity" defaultButton="true"/>
      </VBox>

      <Region VBox.vgrow="ALWAYS"/>

    </VBox>

  </HBox>

</StackPane>
