<?xml version="1.0" encoding="UTF-8"?>

<!--
  Inventory (T063, FR-18, FR-22). Card list with search + status chips on the left; a navy
  detail side-panel on the right (design mockup #4) showing the selected item's figures, its
  recent ledger movements, and the adjust action. On-hand is display-only; it moves only through
  Adjust, which writes a ledger movement + on-hand in one transaction (BR-21).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.InventoryController"
      styleClass="content" spacing="18">

  <HBox alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Inventory"/>
      <Label styleClass="greeting-sub" text="Stock on hand, reorder levels, and low-stock alerts."/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="newButton" styleClass="qa" text="+ New item"/>
    <Button fx:id="refreshButton" styleClass="qa" text="Refresh"/>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <HBox spacing="20" VBox.vgrow="ALWAYS">

    <!-- Item list with search + filter chips -->
    <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="0">
      <FlowPane hgap="10" vgap="10">
        <TextField fx:id="searchField" promptText="Search stock items…" prefWidth="290"/>
        <Button fx:id="chipAll" styleClass="chip" text="All"/>
        <Button fx:id="chipLow" styleClass="chip" text="Low / Out"/>
        <Button fx:id="chipInStock" styleClass="chip" text="In stock"/>
      </FlowPane>

      <VBox spacing="6" VBox.vgrow="ALWAYS" minWidth="0">
        <HBox styleClass="list-head" alignment="CENTER_LEFT" spacing="14">
          <padding><javafx.geometry.Insets left="24" right="22"/></padding>
          <Label styleClass="list-col-head" text="STOCK ITEM"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label styleClass="list-col-head" text="ON HAND" prefWidth="90" alignment="CENTER_RIGHT"/>
          <Label styleClass="list-col-head" text="REORDER" prefWidth="80" alignment="CENTER_RIGHT"/>
          <Label styleClass="list-col-head" text="STATUS" prefWidth="92" alignment="CENTER_RIGHT"/>
        </HBox>
        <ListView fx:id="itemList" styleClass="card-list" VBox.vgrow="ALWAYS"/>
      </VBox>
    </VBox>

    <!-- Navy detail side-panel -->
    <VBox fx:id="detailPanel" styleClass="detail-panel" minWidth="344" prefWidth="344" maxWidth="344">

      <VBox styleClass="detail-head" spacing="7">
        <HBox alignment="CENTER_LEFT">
          <Label fx:id="headPill" styleClass="pill,on-navy" text=""/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="headTopline" styleClass="detail-topline" text=""/>
        </HBox>
        <Label fx:id="headTitle" styleClass="detail-title" text="New stock item"/>
        <HBox alignment="BASELINE_LEFT" spacing="7">
          <Label fx:id="headFigure" styleClass="detail-figure" text=""/>
          <Label fx:id="headFigureUnit" styleClass="detail-figure-unit" text=""/>
        </HBox>
      </VBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;">
        <StackPane>

          <!-- DETAIL MODE — key-value rows, recent movements, adjust -->
          <VBox fx:id="detailBody" styleClass="detail-body" visible="false" managed="false">
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="Unit of measure"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvUnit" styleClass="v" text=""/>
            </HBox>
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="On hand"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvOnHand" styleClass="v" text=""/>
            </HBox>
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="Reorder level"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvReorder" styleClass="v" text=""/>
            </HBox>
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="Record status"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvStatus" styleClass="v" text=""/>
            </HBox>

            <Label styleClass="section-label" text="RECENT MOVEMENTS">
              <VBox.margin><javafx.geometry.Insets top="18" bottom="4"/></VBox.margin>
            </Label>
            <VBox fx:id="movementsBox" spacing="2"/>
          </VBox>

          <!-- FORM MODE — create / edit -->
          <VBox fx:id="formBody" styleClass="detail-body" spacing="13">
            <padding><javafx.geometry.Insets top="16"/></padding>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Name"/>
              <TextField fx:id="nameField"/>
            </VBox>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Unit of measure"/>
              <TextField fx:id="unitField" promptText="e.g. kg, L, each"/>
            </VBox>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Reorder level"/>
              <TextField fx:id="reorderField"/>
            </VBox>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Opening quantity (on create)"/>
              <TextField fx:id="openingField"/>
            </VBox>
          </VBox>

        </StackPane>
      </ScrollPane>

      <!-- pinned footer — actions never scroll away -->
      <VBox fx:id="detailFooter" spacing="10" visible="false" managed="false">
        <padding><javafx.geometry.Insets top="8" right="24" bottom="20" left="24"/></padding>
        <HBox spacing="8">
          <TextField fx:id="adjustField" promptText="e.g. 5 or -2" HBox.hgrow="ALWAYS"/>
          <Button fx:id="adjustButton" styleClass="btn-primary" text="Adjust"/>
        </HBox>
        <HBox spacing="8">
          <Button fx:id="editButton" styleClass="qa" text="Edit item" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
          <Button fx:id="deactivateButton" styleClass="qa" text="Toggle active" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
      </VBox>
      <VBox fx:id="formFooter" spacing="8">
        <padding><javafx.geometry.Insets top="8" right="24" bottom="20" left="24"/></padding>
        <Button fx:id="saveButton" styleClass="btn-gold" text="Save item" maxWidth="Infinity"/>
        <Button fx:id="cancelButton" styleClass="qa" text="Cancel" maxWidth="Infinity"/>
      </VBox>
    </VBox>

  </HBox>

</VBox>
