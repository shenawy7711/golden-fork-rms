<?xml version="1.0" encoding="UTF-8"?>

<!--
  Tables (T042, FR-08, FR-09) — the floor as a card grid with status chips, plus the navy
  detail side-panel from design mockup #2. Cards go navy when occupied; selecting a card
  drives the panel. Defining/deleting needs DEFINE_TABLES (Manager/Admin); status moves need
  UPDATE_TABLE_STATUS, and TableService enforces the state machine (BR-12) either way.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.TableController"
      styleClass="content" spacing="18">

  <HBox alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="4">
      <Label styleClass="h1,heading" text="Tables"/>
      <Label styleClass="greeting-sub" text="The floor right now, and the layout behind it."/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="newButton" styleClass="qa" text="+ New table"/>
    <Button fx:id="refreshButton" styleClass="qa" text="Refresh"/>
  </HBox>

  <Label fx:id="messageLabel" styleClass="form-error" maxWidth="Infinity"
         wrapText="true" visible="false" managed="false"/>

  <HBox spacing="20" VBox.vgrow="ALWAYS">

    <!-- Floor: status chips + card grid -->
    <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="0">
      <FlowPane hgap="10" vgap="10">
        <Button fx:id="chipAll" styleClass="chip" text="All"/>
        <Button fx:id="chipFree" styleClass="chip" text="Free"/>
        <Button fx:id="chipOccupied" styleClass="chip" text="Occupied"/>
        <Button fx:id="chipReserved" styleClass="chip" text="Reserved"/>
        <Button fx:id="chipCleaning" styleClass="chip" text="Cleaning"/>
      </FlowPane>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;">
        <FlowPane fx:id="floorPane" hgap="14" vgap="14"/>
      </ScrollPane>
    </VBox>

    <!-- Navy detail side-panel -->
    <VBox fx:id="detailPanel" styleClass="detail-panel" minWidth="344" prefWidth="344" maxWidth="344">

      <VBox styleClass="detail-head" spacing="7">
        <HBox alignment="CENTER_LEFT">
          <Label fx:id="headPill" styleClass="pill,on-navy" text=""/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="headTopline" styleClass="detail-topline" text=""/>
        </HBox>
        <Label fx:id="headTitle" styleClass="detail-title" text="New table"/>
        <HBox alignment="BASELINE_LEFT" spacing="7">
          <Label fx:id="headFigure" styleClass="detail-figure" text=""/>
          <Label fx:id="headFigureUnit" styleClass="detail-figure-unit" text=""/>
        </HBox>
      </VBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;">
        <StackPane>

          <!-- DETAIL MODE -->
          <VBox fx:id="detailBody" styleClass="detail-body" visible="false" managed="false">
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="Status"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvStatus" styleClass="v" text=""/>
            </HBox>
            <HBox styleClass="kv-row" alignment="CENTER_LEFT">
              <Label styleClass="k" text="Capacity"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="kvCapacity" styleClass="v" text=""/>
            </HBox>
            <Label fx:id="statusHint" styleClass="hint" wrapText="true" text="">
              <VBox.margin><javafx.geometry.Insets top="12"/></VBox.margin>
            </Label>
          </VBox>

          <!-- FORM MODE -->
          <VBox fx:id="formBody" styleClass="detail-body" spacing="13">
            <padding><javafx.geometry.Insets top="16"/></padding>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Label"/>
              <TextField fx:id="labelField" promptText="e.g. T1"/>
            </VBox>
            <VBox styleClass="field-group" spacing="7">
              <Label text="Capacity"/>
              <TextField fx:id="capacityField" promptText="seats (≥ 1)"/>
            </VBox>
          </VBox>

        </StackPane>
      </ScrollPane>

      <!-- pinned footers -->
      <VBox fx:id="detailFooter" spacing="8" visible="false" managed="false">
        <padding><javafx.geometry.Insets top="8" right="24" bottom="20" left="24"/></padding>
        <VBox fx:id="transitionBox" spacing="8"/>
        <HBox spacing="8">
          <Button fx:id="editButton" styleClass="qa" text="Edit table" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
          <Button fx:id="deleteButton" styleClass="qa" text="Delete" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
      </VBox>
      <VBox fx:id="formFooter" spacing="8">
        <padding><javafx.geometry.Insets top="8" right="24" bottom="20" left="24"/></padding>
        <Button fx:id="saveButton" styleClass="btn-gold" text="Save table" maxWidth="Infinity"/>
        <Button fx:id="cancelButton" styleClass="qa" text="Cancel" maxWidth="Infinity"/>
      </VBox>
    </VBox>

  </HBox>

</VBox>
